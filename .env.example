# Copy to .env and fill in. Never commit real keys.

# --- Required for the recording (Claude must be the declared model) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional rehearsal fallback if Claude key is late
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Gnani Agent Platform (live outbound calls) ---
GNANI_PLATFORM_API_KEY=
GNANI_BOT_ID=
GNANI_ENVIRONMENT=development

# --- Gnani Vachana STT (live voice notes) ---
# Existing GNANI_API_KEY also works as a fallback.
GNANI_STT_API_KEY=
GNANI_API_KEY=

# --- WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_VERIFY_TOKEN=gharpass-verify
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_SHEET_ID=

# --- Actor phones (10 digits, must be WhatsApp + Gnani-whitelisted) ---
RITIKA_PHONE=9800000022
SUNITA_PHONE=9800000010
RAMESH_PHONE=9800000033

# --- Optional live UAT (otherwise the curtain person pastes doc-shaped JSON) ---
PINELABS_LIVE=false
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MERCHANT_ID=

DELHIVERY_LIVE=false
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=

PUBLIC_BASE_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000
